generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  id         String    @id @db.VarChar(32)
  name       String    @db.VarChar(80)
  wechatName String    @map("wechat_name") @db.VarChar(80)
  phone      String    @default("") @db.VarChar(40)
  source     String    @db.VarChar(40)
  address    String    @db.VarChar(255)
  preference String    @db.Text
  status     String    @db.VarChar(32)
  balance    Decimal   @default(0) @db.Decimal(12, 2)
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([status])
  @@map("customers")
}

model Order {
  id            String    @id @db.VarChar(32)
  customerId    String    @map("customer_id") @db.VarChar(32)
  customerName  String    @map("customer_name") @db.VarChar(80)
  serviceDate   DateTime  @map("service_date") @db.Date
  mealName      String    @map("meal_name") @db.VarChar(120)
  supplierId    String    @map("supplier_id") @db.VarChar(32)
  supplierName  String    @map("supplier_name") @db.VarChar(80)
  amount        Decimal   @db.Decimal(12, 2)
  supplierCost  Decimal   @map("supplier_cost") @db.Decimal(12, 2)
  deliveryCost  Decimal   @map("delivery_cost") @db.Decimal(12, 2)
  grossProfit   Decimal   @map("gross_profit") @db.Decimal(12, 2)
  status        String    @db.VarChar(32)
  paymentStatus String    @map("payment_status") @db.VarChar(32)
  note          String    @db.Text
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([status])
  @@index([serviceDate])
  @@map("orders")
}
